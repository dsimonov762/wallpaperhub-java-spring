<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.wallpaperhub</groupId>
    <artifactId>wallpaperhub-java-spring</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>account</artifactId>
  <name>account-service</name>
  <description>account-service (WP-S1): users, profiles, registration.</description>

  <dependencies>
    <dependency>
      <groupId>dev.wallpaperhub</groupId>
      <artifactId>platform</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- the gRPC server of contracts/proto (port 9090): Spring Boot 4.2 manages the starter and the versions of grpc-java and protobuf-java -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-grpc-server</artifactId>
    </dependency>
    <!-- server reflection, so that `grpcurl -plaintext localhost:9090 list` works; Spring Boot registers it when this is on the classpath -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-services</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- an in-process gRPC server and client for the tests: no network port -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- a real PostgreSQL for UserPersistenceTest; the version is managed by Spring Boot (testcontainers.version) -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>account</finalName>
    <plugins>
      <plugin>
        <!-- Generates the Java classes and the gRPC stubs of the contract. Spring Boot's parent configures the plugin (protoc and grpc-java versions,
             the generate goal); the only change is the source: contracts/proto is the vendored contract, and a copy under src/ would drift from it. -->
        <groupId>io.github.ascopes</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <configuration>
          <sourceDirectories combine.self="override">
            <sourceDirectory>${project.basedir}/../contracts/proto</sourceDirectory>
          </sourceDirectories>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- exposes the path of the Mockito jar as ${org.mockito:mockito-core:jar}, for the -javaagent below -->
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Mockito as an agent from the start: without it, Mockito attaches itself at runtime, which newer JDKs will forbid -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
