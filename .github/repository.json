{
  "description": "Java 25 / Spring Boot 4 implementation of the four Wallpaper Hub microservices (account, media, catalog, notification), checked by the conformance suite of wallpaperhub-template. Maven multi-module with a shared platform module.",
  "homepage": "",
  "topics": [
    "java",
    "java-25",
    "spring-boot",
    "spring-boot-4",
    "maven",
    "microservices",
    "polyglot",
    "rest-api",
    "grpc",
    "kafka",
    "openapi",
    "oauth2",
    "jwt",
    "keycloak",
    "opentelemetry",
    "conformance-testing",
    "docker",
    "github-actions"
  ],
  "settings": {
    "has_issues": true,
    "has_wiki": false,
    "has_projects": false,
    "is_template": false,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "allow_auto_merge": true,
    "allow_update_branch": true,
    "delete_branch_on_merge": true,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "PR_BODY",
    "web_commit_signoff_required": false
  },
  "security": {
    "secret_scanning": true,
    "secret_scanning_push_protection": true,
    "dependabot_alerts": true,
    "dependabot_security_updates": false,
    "private_vulnerability_reporting": true,
    "code_scanning": {
      "state": "configured",
      "query_suite": "default",
      "languages": [
        "actions",
        "java-kotlin"
      ]
    }
  },
  "actions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "environments": {
    "staging": {
      "reviewers": [],
      "prevent_self_review": false,
      "wait_timer": 0,
      "deploy_from": {
        "branches": [
          "master"
        ],
        "tags": [
          "v*"
        ]
      }
    },
    "production": {
      "reviewers": [
        "owner"
      ],
      "prevent_self_review": false,
      "wait_timer": 0,
      "deploy_from": {
        "branches": [],
        "tags": [
          "v*"
        ]
      }
    }
  }
}
