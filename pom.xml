<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot manages the versions of its libraries and of the Maven plugins used here. Nothing below names a version
       except the project's own (and the Boot version on the next line): to update, change the Boot version. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.2.0</version>
    <relativePath/>
  </parent>

  <groupId>dev.wallpaperhub</groupId>
  <artifactId>wallpaperhub-java-spring</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Wallpaper Hub (Java, Spring Boot)</name>
  <description>Implementation of the four Wallpaper Hub services in Java with Spring Boot.</description>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The OpenTelemetry Java agent is not a library of the services but a file next to them (account/Dockerfile, make otel-agent): Spring Boot does not
         manage it, so its version is written here, and Renovate moves it (.github/renovate.json5). Agent 3.x changes telemetry defaults: read its notes first. -->
    <opentelemetry-javaagent.version>2.33.1</opentelemetry-javaagent.version>
    <!-- Code quality tools that Spring Boot does not manage (its own plugins are in the parent): Renovate moves these three (.github/renovate.json5).
         Error Prone and the formatter run inside the build's JVM, which needs the add-exports options of .mvn/jvm.config on JDK 16 and later. -->
    <spotless-maven-plugin.version>3.11.0</spotless-maven-plugin.version>
    <palantir-java-format.version>2.90.0</palantir-java-format.version>
    <error-prone.version>2.53.0</error-prone.version>
  </properties>

  <modules>
    <module>platform</module>
    <module>account</module>
    <!-- media, catalog and notification are added by WP-S2, WP-S3 and WP-S4 -->
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <!-- Error Prone (https://errorprone.info) checks every compilation, main and test code: a bug pattern of severity ERROR fails the build, warnings are
               printed. A false positive is suppressed at the smallest scope with @SuppressWarnings("CheckName") and a comment saying why. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <compilerArgs>
              <arg>-XDcompilePolicy=simple</arg>
              <arg>--should-stop=ifError=FLOW</arg>
              <!-- the checks are for code that people write: not for what protoc and other generators put in target/generated-sources -->
              <arg>-Xplugin:ErrorProne -XepExcludedPaths:.*/generated-sources/.*</arg>
            </compilerArgs>
            <annotationProcessorPaths>
              <path>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_core</artifactId>
                <version>${error-prone.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <!-- Formatting: `make fmt` rewrites the Java files (spotless:apply), `./mvnw verify` fails when one is not formatted (spotless:check). -->
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-maven-plugin.version}</version>
          <configuration>
            <java>
              <palantirJavaFormat>
                <version>${palantir-java-format.version}</version>
              </palantirJavaFormat>
              <removeUnusedImports/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <!-- Used only as `./mvnw -N dependency:copy` (make otel-agent, account/Dockerfile): puts the agent in target/otel/. It is bound to no lifecycle phase. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <configuration>
            <artifactItems>
              <artifactItem>
                <groupId>io.opentelemetry.javaagent</groupId>
                <artifactId>opentelemetry-javaagent</artifactId>
                <version>${opentelemetry-javaagent.version}</version>
                <type>jar</type>
                <destFileName>opentelemetry-javaagent.jar</destFileName>
              </artifactItem>
            </artifactItems>
            <outputDirectory>${project.build.directory}/otel</outputDirectory>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.wallpaperhub</groupId>
        <artifactId>platform</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
